MONGO_URI=mongodb://127.0.0.1:27017/trackwise
PORT=5000

# REQUIRED. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin(s) allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173

# Public sign-up is closed (admin creates accounts). Set to true to reopen it.
ALLOW_PUBLIC_REGISTER=false

# Used only by `npm run seed:admin` (password: min 8 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@trackwise.local
ADMIN_NAME=System Admin
